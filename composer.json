{
    "name": "zeroboiler/value-objects",
    "description": "Immutable value objects with validation and Eloquent auto-casting for Laravel 13",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "value-objects",
        "immutable",
        "eloquent-casting",
        "money",
        "email",
        "phone",
        "address",
        "url"
    ],
    "authors": [
        {
            "name": "ZeroBoiler",
            "email": "hello@zeroboiler.dev"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "ext-intl": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0",
        "illuminate/database": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "ZeroBoiler\\ValueObjects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroBoiler\\ValueObjects\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "rector": "rector",
        "ci": [
            "@lint",
            "@analyse",
            "@rector",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroBoiler\\ValueObjects\\ValueObjectsServiceProvider"
            ]
        }
    },
    "suggest": {
        "giggsey/libphonenumber-for-php": "For accurate phone number parsing, validation, and country code detection instead of the prefix-based heuristic"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "1.27.0"
}
